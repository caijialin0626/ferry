# Execution host: runs the agent CLIs on this machine and stores its chats locally in SQLite.

# Shared secret for a Web service configured with FERRY_HOST_URL (at least 24 characters).
# Paired Web services get their own credential and do not need it.
FERRY_HOST_TOKEN=change-me-to-a-long-random-string

# Listen on a private address (LAN, Tailscale, WireGuard) when the Web service runs elsewhere.
FERRY_HOST_BIND=127.0.0.1
FERRY_HOST_PORT=8788

# Optional overrides.
# FERRY_HOST_DATA=/absolute/path/to/ferry-data
# FERRY_CODEX_BIN=/path/to/codex
# FERRY_CLAUDE_BIN=/path/to/claude
# FERRY_AGY_BIN=/path/to/agy
