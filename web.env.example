# Web service: serves the UI and forwards requests to execution hosts. It stores no chats.

# Access code for the browser sign-in (at least 24 characters).
FERRY_WEB_LOGIN_TOKEN=change-me-to-a-long-random-string

# Public address users open. Required whenever it differs from http://BIND:PORT,
# for example behind a reverse proxy or inside Docker.
FERRY_WEB_ORIGIN=http://localhost:8787
FERRY_WEB_PORT=8787

# Optional primary execution host. Without it, add machines from the UI with a pairing code.
# FERRY_HOST_URL=http://192.168.1.20:8788
# FERRY_HOST_TOKEN=same-value-as-on-the-host

# Optional: trust Tailscale Serve identity instead of an access code.
# Requires FERRY_WEB_BIND=127.0.0.1 and an https:// FERRY_WEB_ORIGIN.
# FERRY_TAILSCALE_LOGIN=you@example.com
